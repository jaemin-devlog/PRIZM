        "parentId": "SV3-U45-P04",
        "documentId": "SV3-U45-D01",
        "versionId": "SV3-U45-D01-V01",
        "sourcePath": "documents/sv3-u45-typed-capability-v01.txt",
        "sourceType": "TXT_TEXT",
        "page": null,
        "charStart": 178,
        "charEnd": 221,
        "lineStart": 13,
        "lineEnd": 13,
        "text": "주요 냉각 최적화 검증은 18개월 동안 운영 데이터와 계절별 부하를 확인했다.",
        "textSha256": "6e7adc8bbb984c47ecf3c568ba96fda31a3ca89208cda815d7745e3a9f097c13"
      }
    },
    {
      "parentId": "SV3-U45-P05",
      "userBundleId": "SV3-U45",
      "documentId": "SV3-U45-D01",
      "versionId": "SV3-U45-D01-V01",
