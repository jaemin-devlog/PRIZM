# Spring profile and HTTP
SPRING_PROFILES_ACTIVE=local
# Host port for the backend container. The container itself always uses 8080.
SERVER_PORT=8080
# Host port for the frontend container.
PRIZM_FRONTEND_PORT=5173

# Authentication (use a separately generated value with at least 32 characters)
PRIZM_JWT_SECRET=
PRIZM_JWT_EXPIRATION_SECONDS=3600
PRIZM_JWT_ISSUER=prizm
PRIZM_CORS_ALLOWED_ORIGINS=http://localhost:5173

# One-time local SYSTEM_ADMIN bootstrap. Keep disabled except for the creation run.
# Passwords must be at least 12 characters and at most 72 UTF-8 bytes for BCrypt.
PRIZM_BOOTSTRAP_SYSTEM_ADMIN_ENABLED=false
PRIZM_BOOTSTRAP_SYSTEM_ADMIN_EMAIL=
PRIZM_BOOTSTRAP_SYSTEM_ADMIN_PASSWORD=

# One-time local demo USER bootstrap. Keep disabled except for the creation run.
# Never enable it in the same startup as the SYSTEM_ADMIN bootstrap above.
# The demo role is fixed to USER; no role setting is exposed.
PRIZM_BOOTSTRAP_DEMO_USER_ENABLED=false
PRIZM_BOOTSTRAP_DEMO_USER_EMAIL=
PRIZM_BOOTSTRAP_DEMO_USER_PASSWORD=

# Local PostgreSQL / pgvector
COMPOSE_PROJECT_NAME=prizm
PRIZM_DB_NAME=prizm
PRIZM_DB_HOST=localhost
PRIZM_DB_PORT=5432
PRIZM_DB_USERNAME=prizm_app
PRIZM_DB_PASSWORD=replace-local-runtime-password

# Flyway owns the schema. The runtime role has no DDL permission.
PRIZM_FLYWAY_USERNAME=prizm_owner
PRIZM_FLYWAY_PASSWORD=replace-local-owner-password

# The opensql profile requires two explicit URLs:
# - PRIZM_DB_URL: runtime JDBC endpoint, normally OpenProxy
# - PRIZM_FLYWAY_URL: migration endpoint confirmed by the OpenSQL environment owner
# Do not assume both URLs are identical until DDL support through OpenProxy is verified.
# PRIZM_DB_URL=jdbc:postgresql://openproxy-host:5432/prizm
# PRIZM_FLYWAY_URL=jdbc:postgresql://migration-host:5432/prizm

# Local files
PRIZM_STORAGE_ROOT=./var/storage
PRIZM_STORAGE_TEMP=./var/tmp

# Host Ollama. bge-m3 is the initial benchmark candidate.
PRIZM_OLLAMA_BASE_URL=http://localhost:11434
# Docker Compose reaches a host Ollama through this address.
PRIZM_COMPOSE_OLLAMA_BASE_URL=http://host.docker.internal:11434
PRIZM_EMBEDDING_MODEL=bge-m3
PRIZM_EMBEDDING_DIMENSIONS=1024

# TXT/PDF document processing
PRIZM_UPLOAD_MAX_FILE_SIZE_BYTES=10485760
PRIZM_DOCUMENT_PDF_MAX_PAGES=300
PRIZM_DOCUMENT_PDF_MAX_EXTRACTED_CHARACTERS=2000000
PRIZM_MAX_CHUNK_LENGTH=800
PRIZM_CHUNK_OVERLAP=120
PRIZM_INDEXING_POLL_DELAY_MS=1000
PRIZM_INDEXING_LEASE_DURATION=10m
PRIZM_INDEXING_LEASE_REFRESH_CHUNK_INTERVAL=10
PRIZM_INDEXING_RECOVERY_DELAY_MS=60000
PRIZM_INDEXING_WORKER_ENABLED=true

# Orphan-file cleanup worker
PRIZM_CLEANUP_WORKER_ENABLED=true
PRIZM_CLEANUP_POLL_DELAY_MS=5000
PRIZM_CLEANUP_RECOVERY_DELAY_MS=60000
PRIZM_CLEANUP_BATCH_SIZE=10
PRIZM_CLEANUP_LEASE_DURATION=5m

# Vite development proxy (only when running the frontend without Docker)
PRIZM_FRONTEND_PROXY_TARGET=http://localhost:8080
