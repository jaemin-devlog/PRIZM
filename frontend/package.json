{
  "name": "prizm-frontend",
  "description": "PRIZM frontend shell",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "22.17.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test:unit": "node --experimental-strip-types --test test/document-processing-presentation.test.ts",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "sbom": "node ../scripts/generate-frontend-sbom.mjs"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "postcss": "8.5.25"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.17.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.1.4"
  }
}
