        "parentId": "SV3-U42-P01",
        "documentId": "SV3-U42-D01",
        "versionId": "SV3-U42-D01-V01",
        "sourcePath": "documents/sv3-u42-typed-capability-v01.txt",
        "sourceType": "TXT_TEXT",
        "page": null,
        "charStart": 60,
        "charEnd": 167,
        "lineStart": 4,
        "lineEnd": 4,
        "text": "For the permanent exhibit, the wayfinding error rate decreased by 38% after the floor markers were revised.",
        "textSha256": "25eec1f657c573ad096bf76ff4f5756d4cc970470b244962123342d1e92c02dc"
      }
    },
    {
