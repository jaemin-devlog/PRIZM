        "spanId": "SV3-U45-P03-PS01",
        "parentId": "SV3-U45-P03",
        "documentId": "SV3-U45-D01",
        "versionId": "SV3-U45-D01-V01",
        "sourcePath": "documents/sv3-u45-typed-capability-v01.txt",
        "sourceType": "TXT_TEXT",
        "page": null,
        "charStart": 132,
        "charEnd": 167,
        "lineStart": 10,
        "lineEnd": 10,
        "text": "설비 점검 절차를 바꾼 뒤 정비 알림 누락률이 27% 감소했다.",
        "textSha256": "b84fdb3220a91c497438af3d34313ae22827e9aed3ef6c682dac93eb2f30a2f6"
      }
    },
    {
      "parentId": "SV3-U45-P04",
      "userBundleId": "SV3-U45",
      "documentId": "SV3-U45-D01",
      "versionId": "SV3-U45-D01-V01",
      "label": "주요 검증 기간",
