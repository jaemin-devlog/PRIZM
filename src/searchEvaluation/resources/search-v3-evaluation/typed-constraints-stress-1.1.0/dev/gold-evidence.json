        "spanId": "SV3-U41-P03-PS01",
        "parentId": "SV3-U41-P03",
        "documentId": "SV3-U41-D01",
        "versionId": "SV3-U41-D01-V01",
        "sourcePath": "documents/sv3-u41-typed-capability-v01.txt",
        "sourceType": "TXT_TEXT",
        "page": null,
        "charStart": 128,
        "charEnd": 168,
        "lineStart": 10,
        "lineEnd": 10,
        "text": "같은 분기에는 배송 라벨 680건을 재발행해 주소 정정 요청을 반영했다.",
        "textSha256": "4f8df94fc4bc65b4cf17cb92b264be71b6daff889ad864e17c5540a39879b950"
      }
    },
    {
      "parentId": "SV3-U42-P01",
      "userBundleId": "SV3-U42",
