        "sourceType": "TXT_TEXT",
        "page": null,
        "charStart": 50,
        "charEnd": 141,
        "lineStart": 4,
        "lineEnd": 4,
        "text": "The redesigned booking flow achieved an 80% task completion rate in the controlled rollout.",
